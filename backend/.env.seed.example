# Copy to backend/.env.seed and fill in DATABASE_URL's host + DATABASE_PASSWORD.
# That file is gitignored.
#
# Keeping these in a file rather than on the command line means they never
# enter your shell history, never appear in `ps` output, and never end up in a
# screenshot of your terminal.

# From Supabase -> Connect -> Session pooler. Replace ONLY the host part.
# It looks like:  aws-0-ap-south-1.pooler.supabase.com
DATABASE_URL=jdbc:postgresql://REPLACE-WITH-YOUR-POOLER-HOST:5432/postgres

DATABASE_USER=postgres.lzypueapchuothxckgnq

# Your Supabase database password.
DATABASE_PASSWORD=

# Deliberately a throwaway, and deliberately NOT your production secret.
#
# The application refuses to start without a signing key of at least 32 bytes,
# so the seed run needs one to boot. But this run only writes rows -- it issues
# no tokens that anybody will ever present. Using a fixed dummy here means
# there is no reason for your real JWT_SECRET to be on this machine, in this
# file, or in a screenshot.
JWT_SECRET=seed-run-only-not-a-real-secret-do-not-deploy-this-value
