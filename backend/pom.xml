<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.civictrack</groupId>
    <artifactId>civictrack-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>civictrack-backend</name>
    <description>Municipal issue reporting with bounded incremental geo-clustering</description>

    <properties>
        <java.version>21</java.version>
        <shedlock.version>6.10.0</shedlock.version>
        <springdoc.version>2.9.1</springdoc.version>
    </properties>

    <dependencies>
        <!-- core -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          Declared explicitly, though not strictly required today: aspectjweaver
          already arrives transitively via spring-boot-starter-data-jpa ->
          spring-aspects. Verified by removing this starter and watching
          IngestMetricsIT still pass.

          It stays because we depend on AOP directly (@Timed on the ingest path
          is an AspectJ aspect), and inheriting that capability from the
          persistence starter is a coupling nobody would think to preserve while
          changing persistence. What actually makes @Timed record is the
          TimedAspect bean in ObservabilityConfig: remove that and
          IngestMetricsIT turns red, which is also verified.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
          Security. The resource-server starter supplies JwtDecoder and
          JwtAuthenticationConverter. There is deliberately no hand-written
          authentication filter and no jjwt dependency in this project.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!--
          Spatial. This is what maps org.locationtech.jts.geom.Point to
          geometry(Point,4326). Version is managed by the Boot parent BOM.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-spatial</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- migrations: Flyway owns the schema, Hibernate only validates it -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- distributed scheduler lock for the SLA sweep -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>

        <!-- API docs -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
          Lombok is for entities only. DTOs are Java 21 records with static
          from(Entity) factories; MapStruct is deliberately not used.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Colima (the Homebrew container runtime) puts its Docker socket under
          ~/.colima rather than /var/run/docker.sock, and Testcontainers fails
          with "Could not find a valid Docker environment" without being told.

          The profile activates only when that socket actually exists, so it is
          a no-op on CI and on machines running Docker Desktop. The alternative,
          asking every developer to export DOCKER_HOST before running the
          tests, is a step that gets forgotten and then misdiagnosed.
        -->
        <profile>
            <id>colima</id>
            <activation>
                <file>
                    <exists>${user.home}/.colima/default/docker.sock</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <environmentVariables>
                                <DOCKER_HOST>unix://${user.home}/.colima/default/docker.sock</DOCKER_HOST>
                                <!-- Path Ryuk bind-mounts INSIDE the VM, which
                                     is the conventional location even though
                                     the host path differs. -->
                                <TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>/var/run/docker.sock</TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
              Integration tests are the primary tests in this project: the
              clustering engine cannot be meaningfully tested without real
              PostGIS. Surefire therefore runs *IT alongside *Test, so that
              `mvn test` means what a reader expects it to mean, and CI cannot
              go green having skipped the tests that matter.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <!--
                      Pinned. Surefire's default is `filesystem`, which is the
                      order the OS happens to list the class files in - and that
                      differs between macOS and Linux. The suite therefore ran in
                      one order on every developer machine and a different one on
                      every CI runner, and two order-dependent tests hid in the
                      gap: they passed locally and failed on CI for a week while
                      the cause was guessed at three times. See DD-052.

                      `alphabetical` is not better than `filesystem` at finding
                      such bugs. It is better at not HIDING them, because it is
                      the same everywhere. Tests should not depend on order at
                      all, and the way to check that is to run the suite under
                      -Dsurefire.runOrder=reversealphabetical, which is how both
                      of those bugs were finally caught.
                    -->
                    <runOrder>alphabetical</runOrder>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
